---
/** 404 in the new design. */
import { SITE } from '@config';
import { linksWithHome } from '@features/content';
import PageShell from '@shell/PageShell.astro';
import NotFoundView from '@views/NotFoundView.astro';
---

<PageShell title={`Page not found · ${SITE.title}`} headerNav="always" navLinks={linksWithHome}>
    <NotFoundView />
</PageShell>

<script>
    import { initGoBack } from '@features/go-back';

    initGoBack();
</script>
