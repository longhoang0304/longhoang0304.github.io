---
/** Search in the new design. Posts are rendered at build time; lib/search.ts filters them in the browser. */
import { SITE } from '@config';
import { linksWithHome } from '@lib/content';
import { getSitePosts } from '@lib/site-posts';
import PageShell from '@shell/PageShell.astro';
import SearchView from '@views/SearchView.astro';

const posts = await getSitePosts();
---

<PageShell title={`Search · ${SITE.title}`} headerNav="always" navLinks={linksWithHome}>
    <SearchView posts={posts} />
</PageShell>

<script>
    import { initSearch } from '@lib/search';

    initSearch();
</script>
