---
/** Every tag, most used first. */
import { linksWithHome } from '@features/site-info';
import { getSitePosts } from '@features/site-posts';
import { getTagCounts } from '@features/tag-counts';
import PageShell from '@shell/PageShell.astro';
import TagsView from '@views/TagsView.astro';

const tags = getTagCounts(await getSitePosts());
---

<PageShell title="Pick a trail" headerNav="always" navLinks={linksWithHome} bars="flow">
    <TagsView tags={tags} />
</PageShell>
