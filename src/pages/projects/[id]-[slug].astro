---
/** One post in the new design. Drafts are previewable with `astro dev` but never built for production. */
import { render } from 'astro:content';
import { SITE } from '@config';
import { getPostPages } from '@features/post-pages';
import { linksWithHome } from '@features/site-info';
import type { PostEntry, SitePost } from '@features/site-posts';
import PageShell from '@shell/PageShell.astro';
import PostView from '@views/PostView.astro';

export const getStaticPaths = () => getPostPages('projects');

const { entry, post } = Astro.props as { entry: PostEntry; post: SitePost };
const { Content } = await render(entry);
---

<PageShell title={`${post.title} · ${SITE.title}`} description={post.description} headerNav="always" navLinks={linksWithHome}>
    <PostView post={post}>
        <Content />
    </PostView>
</PageShell>
