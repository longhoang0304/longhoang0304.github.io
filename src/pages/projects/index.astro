---
/** Every project, newest first. */
import { SITE } from '@config';
import { getCategoryPosts } from '@features/category-posts';
import { linksWithHome } from '@features/content';
import PageShell from '@shell/PageShell.astro';
import CategoryView from '@views/CategoryView.astro';

const posts = await getCategoryPosts('project');
---

<PageShell title={`Projects · ${SITE.title}`} headerNav="always" navLinks={linksWithHome}>
    <CategoryView lead="Things I" accent="built" posts={posts} />
</PageShell>
