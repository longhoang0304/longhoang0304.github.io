---
import type { Category, CategoryInfo, Post } from '../_lib/types';
import { formatFullDate } from '../_lib/posts';
import Caret from './Caret.astro';
import '../_styles/feed.css';

interface Props {
    id: string;
    posts: Post[];
    categories: Record<Category, CategoryInfo>;
}

const { id, posts, categories } = Astro.props;
---

<section id={id} class="feed" aria-labelledby={`${id}-heading`} data-section>
    <div class="feed-block">
        <h2 id={`${id}-heading`} class="feed-heading">Where it <span class="word">led</span><Caret /></h2>
        {posts.length === 0 ? (
                <p class="feed-empty">
                    <span class="feed-meta">[Soon]</span>
                    <span>Nowhere yet. Still wandering, check back soon.</span>
                </p>
        ) : (
                <ul class="feed-list">
                    {posts.map((post) => (
                            <li>
                                <a href={post.href} class="feed-link">
                                    <span class="feed-meta">
                                        <time class="feed-date" datetime={post.date}>[{formatFullDate(post.date)}]</time>
                                        <span class="feed-category">[{categories[post.category].label}]</span>
                                    </span>
                                    <span class="feed-title" data-truncate>{post.title}</span>
                                    <span class="feed-popup" aria-hidden="true">{post.title}</span>
                                </a>
                            </li>
                    ))}
                </ul>
        )}
    </div>
</section>

<style>
    .feed {
        position: relative;
        min-height: 100vh;
        min-height: 100dvh;
        box-sizing: border-box;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: var(--header-space) var(--edge-x) var(--bar-space);
    }

    /* Shrink to the widest line so the visible text is centered, not a mostly-empty box. */
    .feed-block {
        width: fit-content;
        max-width: min(40rem, 100%);
        text-align: left;
    }

    .feed-heading {
        margin: 0 0 2rem;
        font-family: var(--font-display);
        font-weight: 400;
        font-size: clamp(2rem, 5vw, 3.25rem);
        line-height: 1.1;
        letter-spacing: -0.03em;
    }
</style>

<script>
    import { initTruncationFlags } from '../_lib/truncation';

    initTruncationFlags();
</script>
