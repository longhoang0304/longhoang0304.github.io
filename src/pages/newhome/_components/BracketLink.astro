---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'>;

const { class: className, ...attrs } = Astro.props;
---

<a class:list={['nav-link', className]} {...attrs}>
    <span class="bracket" aria-hidden="true">[</span>
    <slot />
    <span class="bracket" aria-hidden="true">]</span>
</a>

<style>
    .nav-link {
        display: inline-flex;
        align-items: center;
        gap: 0.5em;
        min-height: 44px;
        padding: 0 0.25rem;
    }

    .bracket {
        color: var(--c-bracket);
        transition: color 0.2s ease;
    }

    .nav-link:hover .bracket {
        color: var(--c-accent);
    }

    @media (prefers-reduced-motion: reduce) {
        .bracket { transition: none; }
    }
</style>
