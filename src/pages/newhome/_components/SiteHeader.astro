---
import type { NavLink } from '../_lib/types';
import BracketLink from './BracketLink.astro';
import LocalClock from './LocalClock.astro';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
    location: string;
    timeZone: string;
    /** Shown once the visitor has scrolled past the landing (which has its own nav). */
    links: NavLink[];
    /** Show the nav from the start, for pages without a landing section. */
    alwaysShowNav?: boolean;
}

const { location, timeZone, links, alwaysShowNav = false } = Astro.props;
---

<header class="corner-row site-header">
    <span class="location">{location}</span>
    <nav aria-label="Site" class="header-nav" data-always={alwaysShowNav || undefined}>
        {links.map((link) => (
                <BracketLink href={link.href}>{link.label}</BracketLink>
        ))}
    </nav>
    <div class="header-right">
        <LocalClock timeZone={timeZone} />
        <ThemeToggle />
    </div>
</header>

<style>
    .site-header {
        top: 0;
    }

    .header-nav {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 0 1rem;
        transition: opacity 0.3s ease, visibility 0.3s ease;
    }

    /* Hidden on the landing (before JS runs, too), visible on every later section. */
    :global(:root:not([data-section])) .header-nav:not([data-always]),
    :global(:root[data-section='top']) .header-nav:not([data-always]) {
        opacity: 0;
        visibility: hidden;
    }

    .header-right {
        display: inline-flex;
        align-items: center;
        gap: 0.75rem;
    }

    /* Not enough room for one row: nav drops to its own line under the bar. */
    @media (max-width: 800px) {
        .header-nav {
            order: 3;
            width: 100%;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .header-nav { transition: none; }
    }
</style>
