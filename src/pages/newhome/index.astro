---
/**
 * newhome — "Driven by curiosity" landing page.
 *
 * Colour scheme lives in src/styles/theme.css (global).
 * Page-only pieces live next to this file; the "_" prefix keeps Astro from routing them:
 *   _components/  UI sections and widgets
 *   _lib/         content, types and client-side logic
 *   _styles/      styles shared across the page's components
 *
 * Fonts: all three are SIL OFL, so they can be self-hosted instead of Google Fonts.
 */
import { SITE } from '@config';
import '@styles/theme.css';
import './_styles/page.css';

import Landing from './_components/Landing.astro';
import RecentSection from './_components/RecentSection.astro';
import ScrollHint from './_components/ScrollHint.astro';
import SiteFooter from './_components/SiteFooter.astro';
import SiteHeader from './_components/SiteHeader.astro';
import ThemeInit from './_components/ThemeInit.astro';
import { categories, email, githubUrl, links, linkedinUrl, location, posts, timeZone } from './_lib/content';
import { getRecentPosts } from './_lib/posts';

const year = new Date().getFullYear();
const recentPosts = getRecentPosts(posts);
const sections = [
    { id: 'top', label: 'top' },
    { id: 'recent', label: 'where it led' },
];
---

<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{SITE.title}</title>

    <ThemeInit />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
            rel="stylesheet"
            href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@1,500&family=Bricolage+Grotesque:opsz,wght@12..96,400&family=JetBrains+Mono:wght@400;500&display=swap"
    />
</head>
<body>
    <div class="site">
        <SiteHeader location={location} timeZone={timeZone} links={links} />

        <main>
            <Landing links={links} />
            <RecentSection id="recent" posts={recentPosts} categories={categories} />
        </main>

        <SiteFooter year={year} githubUrl={githubUrl} linkedinUrl={linkedinUrl} email={email} />
        <ScrollHint sections={sections} />
    </div>
</body>
</html>

<script>
    import { initScrollFade } from './_lib/scroll-fade';
    import { initSectionScroll } from './_lib/section-scroll';
    import { initSectionTracker } from './_lib/section-tracker';

    initSectionTracker();
    initSectionScroll();
    initScrollFade();
</script>

<style>
    .site {
        --font-display: 'Bricolage Grotesque', 'Helvetica Neue', Arial, sans-serif;
        --font-poetic: 'Cormorant Garamond', Garamond, Georgia, serif;
        --font-mono: 'JetBrains Mono', ui-monospace, Menlo, monospace;

        /* Page gutters; sections pad by --bar-space so the fixed header/footer never cover them. */
        --edge-x: 2.5rem;
        --edge-y: 2rem;
        --bar-space: calc(44px + 2 * var(--edge-y) + 1rem);
        /* Header is taller where its nav wraps to a second row (see SiteHeader). */
        --header-space: var(--bar-space);

        display: block;
        background: var(--c-bg);
        color: var(--c-text);
        font-family: var(--font-mono);
    }

    @media (max-width: 800px) {
        .site {
            --header-space: calc(var(--bar-space) + 44px);
        }
    }

    @media (max-width: 480px) {
        .site {
            --edge-x: 1.25rem;
            --edge-y: 1.25rem;
        }
    }
</style>
