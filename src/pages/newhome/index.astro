---
/**
 * newhome — "Driven by curiosity" landing page.
 *
 * Colour scheme lives in src/styles/theme.css (global).
 * Pieces of the new design live next to this file; the "_" prefix keeps Astro from routing them:
 *   _components/  page frame (PageShell), sections and widgets — also used by /404
 *   _lib/         content, types and client-side logic
 *   _styles/      styles shared across the components
 *
 * Fonts: all three are SIL OFL, so they can be self-hosted instead of Google Fonts.
 */
import Landing from './_components/Landing.astro';
import PageShell from './_components/PageShell.astro';
import RecentSection from './_components/RecentSection.astro';
import ScrollHint from './_components/ScrollHint.astro';
import { categories, links } from './_lib/content';
import { getRecentPosts, RECENT_LIMIT } from './_lib/posts';
import { getSitePosts } from './_lib/site-posts';

const recentPosts = getRecentPosts(await getSitePosts(), RECENT_LIMIT);
const sections = [
    { id: 'top', label: 'top' },
    { id: 'recent', label: 'where it led' },
];
---

<PageShell>
    <Landing links={links} />
    <RecentSection id="recent" posts={recentPosts} categories={categories} />

    <ScrollHint slot="after" sections={sections} />
</PageShell>

<script>
    import { initSectionScroll } from './_lib/section-scroll';
    import { initSectionTracker } from './_lib/section-tracker';

    initSectionTracker();
    initSectionScroll();
</script>
