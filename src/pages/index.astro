---
/**
 * Home — "Driven by curiosity" landing page.
 *
 * UI layers (Blossom, small size): pages → views → components → elements. Imports only go
 * downward. Everything below the pages lives in src/:
 *   shell/       the frame every page wraps itself in: head, header and footer views, base styles
 *   views/       one region of a page each; lay out only, no colors or type of their own
 *   components/  UI pieces built from elements, business-agnostic
 *   elements/    the smallest pieces; the only places (with components) that own the look
 *   features/    plain functions, one job per file; used by every layer
 *   legacy/      the old blog design, still used by the post and tag pages; not part of the layers
 *
 * Colour scheme lives in src/styles/theme.css (global).
 * Fonts: all three are SIL OFL, so they can be self-hosted instead of Google Fonts.
 */
import ScrollHint from '@components/ScrollHint.astro';
import { links } from '@features/site-info';
import { getRecentPosts, RECENT_LIMIT } from '@features/recent-posts';
import { getSitePosts } from '@features/site-posts';
import PageShell from '@shell/PageShell.astro';
import LandingView from '@views/LandingView.astro';
import RecentPostsView from '@views/RecentPostsView.astro';

const recentPosts = getRecentPosts(await getSitePosts(), RECENT_LIMIT);
const sections = [
    { id: 'top', label: 'top' },
    { id: 'recent', label: 'where it led' },
];
---

<PageShell>
    <LandingView links={links} />
    <RecentPostsView id="recent" posts={recentPosts} />

    <ScrollHint slot="after" sections={sections} />
</PageShell>

<script>
    import { initSectionScroll } from '@features/section-scroll';
    import { initSectionTracker } from '@features/section-tracker';

    initSectionTracker();
    initSectionScroll();
</script>
