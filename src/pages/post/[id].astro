---
// Short rant links (/post/<id>, used by the old RSS feed) forward to /rants/<id>-<slug>.
import { getCollection } from "astro:content";
import { removeDraft } from "@utils/posts";

export async function getStaticPaths() {
  const rants = removeDraft(await getCollection("rants"))
  return rants.map(({ data }) => ({
    params: { id: data.postId },
    props: { href: `/rants/${data.postId}-${data.postSlug}` },
  }))
}

const { href } = Astro.props as { href: string };
return Astro.redirect(href, 301);
---
