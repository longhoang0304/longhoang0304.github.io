---
// Rants used to live at /post/<id>-<slug>; old links forward to /rants/<id>-<slug>.
import { getCollection } from "astro:content";
import { removeDraft } from "@utils/posts";

export async function getStaticPaths() {
  const rants = removeDraft(await getCollection("rants"))
  return rants.map(({ data }) => ({
    params: { id: data.postId, slug: data.postSlug },
  }))
}

const { id, slug } = Astro.params;
return Astro.redirect(`/rants/${id}-${slug}`, 301);
---
