---
/** Every post with one tag, across all sections, newest first. */
import { linksWithHome } from '@features/site-info';
import type { SitePost } from '@features/site-posts';
import { getTagPages } from '@features/tag-pages';
import PageShell from '@shell/PageShell.astro';
import PostListView from '@views/PostListView.astro';

export const getStaticPaths = getTagPages;

const { tag, posts } = Astro.props as { tag: string; posts: SitePost[] };
---

<PageShell title={`Tagged #${tag}`} headerNav="always" navLinks={linksWithHome} bars="flow">
    <PostListView lead="Tagged" accent={`#${tag}`} posts={posts} withCategory back={{ label: 'All trails', href: '/tags' }} />
</PageShell>
