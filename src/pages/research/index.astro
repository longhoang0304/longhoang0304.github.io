---
/** Every research write-up, newest first. */
import { SITE } from '@config';
import { getCategoryPosts } from '@features/category-posts';
import { categories, linksWithHome } from '@features/site-info';
import PageShell from '@shell/PageShell.astro';
import PostListView from '@views/PostListView.astro';

const posts = await getCategoryPosts('research');
const { heading } = categories.research;
---

<PageShell title={`Research · ${SITE.title}`} headerNav="always" navLinks={linksWithHome}>
    <PostListView lead={heading.lead} accent={heading.accent} posts={posts} />
</PageShell>
