---
/** A row of icon-only links (profiles, email, CV, feed). */
import type { IconLink, IconName } from '../features/types';

interface Props {
    links: IconLink[];
}

const { links } = Astro.props;

const icons: Record<IconName, string> = {
    github: '<path d="M9 19c-4.3 1.4-4.3-2.5-6-3m12 5v-3.5c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.2 4.2 0 0 0-.1-3.2s-1.1-.3-3.5 1.3a12.3 12.3 0 0 0-6.2 0C6.5 2.8 5.4 3.1 5.4 3.1a4.2 4.2 0 0 0-.1 3.2A4.6 4.6 0 0 0 4 9.5c0 4.6 2.7 5.7 5.5 6-.6.6-.6 1.2-.5 2V21"></path>',
    linkedin: '<path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6z"></path><rect x="2" y="9" width="4" height="12"></rect><circle cx="4" cy="4" r="2"></circle>',
    mail: '<rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="m3 7 9 6 9-6"></path>',
    cv: '<path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"></path><path d="M14 3v5h5"></path><path d="M9 13h6M9 17h4"></path>',
    rss: '<path d="M5 11a8 8 0 0 1 8 8"></path><path d="M5 4a15 15 0 0 1 15 15"></path><circle cx="6" cy="18" r="1"></circle>',
};
---

<div class="socials">
    {links.map((link) => (
            <a
                    href={link.href}
                    aria-label={link.label}
                    title={link.label}
                    class="icon-link"
                    target={link.external ? '_blank' : undefined}
                    rel={[link.me && 'me', link.external && 'noopener'].filter(Boolean).join(' ') || undefined}
            >
                <svg viewBox="0 0 24 24" aria-hidden="true" set:html={icons[link.icon]} />
            </a>
    ))}
</div>

<style>
    .socials {
        display: flex;
        gap: 0.25rem;
    }

    .icon-link {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 44px;
        height: 44px;
        color: var(--c-muted);
    }

    .icon-link svg {
        width: 20px;
        height: 20px;
        fill: none;
        stroke: currentColor;
        stroke-width: 1.6;
        stroke-linecap: round;
        stroke-linejoin: round;
    }
</style>
