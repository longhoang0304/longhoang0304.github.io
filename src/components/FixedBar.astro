---
/**
 * A bar fixed to the top or bottom edge, holding small uppercase text and controls.
 * It fades out while the page scrolls ([data-scrolling], set by features/scroll-fade.ts).
 * When the shell puts the bars in the page flow (data-bars="flow"), it scrolls with the page instead.
 */
interface Props {
    edge: 'top' | 'bottom';
}

const { edge } = Astro.props;
const Tag = edge === 'top' ? 'header' : 'footer';
---

<Tag class="bar" data-edge={edge}><slot /></Tag>

<style>
    .bar {
        position: fixed;
        left: 0;
        right: 0;
        z-index: 10;
        box-sizing: border-box;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 1rem;
        min-height: calc(44px + 2 * var(--edge-y));
        padding: var(--edge-y) var(--edge-x);
        font-size: 0.75rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--c-muted);
        background: var(--c-bg);
        transition: opacity 0.3s ease;
    }

    .bar[data-edge='top'] { top: 0; }
    .bar[data-edge='bottom'] { bottom: 0; }

    :global(.site[data-bars='flow']) .bar {
        position: static;
    }

    :global(:root[data-scrolling] .site[data-bars='pinned']) .bar {
        opacity: 0;
        pointer-events: none;
    }

    @media (prefers-reduced-motion: reduce) {
        .bar { transition: none; }
    }
</style>
