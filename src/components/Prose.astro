---
/**
 * Long-form text rendered from Markdown: headings, lists, quotes, code, tables, images.
 * The Markdown output has no classes of its own, so its tags are styled inside .prose.
 *
 * Text keeps the container's width. Tables and code blocks may break out by --breakout on
 * each side (set by the layout that has room for it; 0 by default), centered on the text.
 *
 * Body text is serif; headings and tables use the display font, code the mono font.
 * "paper" adds numbered sections, for research-paper style posts.
 */
interface Props {
    variant?: 'post' | 'paper';
}

const { variant = 'post' } = Astro.props;
---

<div class="prose" data-variant={variant}><slot /></div>

<style>
    .prose {
        --wide: var(--breakout, 0px);
        display: grid;
        grid-template-columns: [wide-start] var(--wide) [text-start] minmax(0, 1fr) [text-end] var(--wide) [wide-end];
        margin-inline: calc(-1 * var(--wide));
        font-family: var(--font-serif);
        font-size: 1.1875rem;
        line-height: 1.65;
        color: var(--c-text);
        overflow-wrap: break-word;
    }

    .prose > :global(*) { grid-column: text; }

    /* Wide content: at least the text width, at most the breakout width, centered. */
    .prose > :global(table),
    .prose > :global(pre),
    .prose > :global(figure) {
        grid-column: wide;
        justify-self: center;
        box-sizing: border-box;
        width: fit-content;
        min-width: calc(100% - 2 * var(--wide));
        max-width: 100%;
    }

    .prose :global(h2),
    .prose :global(h3),
    .prose :global(h4),
    .prose :global(table),
    .prose :global(.post-p-image) {
        font-family: var(--font-display);
    }

    .prose > :global(:first-child) { margin-top: 0; }
    .prose > :global(:last-child) { margin-bottom: 0; }

    .prose :global(p),
    .prose :global(ul),
    .prose :global(ol),
    .prose :global(blockquote),
    .prose :global(pre),
    .prose :global(table) {
        margin: 0 0 1.25em;
    }

    /* Headings land below the fixed header when jumped to from a link. Grid items' margins don't
       collapse, so the space above adds to the 1.25em under the paragraph before. */
    .prose :global(h2),
    .prose :global(h3),
    .prose :global(h4) {
        margin: 1.5em 0 0.75em;
        font-weight: 400;
        line-height: 1.2;
        letter-spacing: -0.02em;
        scroll-margin-top: calc(var(--header-space) + 1rem);
    }

    .prose :global(h2) { font-size: 1.875rem; }
    .prose :global(h3) { font-size: 1.375rem; margin-top: 1.25em; }
    .prose :global(h4) { font-size: 1.125rem; font-weight: 600; margin-top: 1em; }

    .prose :global(strong) { font-weight: 600; }

    .prose :global(a) {
        color: var(--c-accent);
        text-decoration: underline;
        text-decoration-thickness: 1px;
        text-underline-offset: 0.2em;
    }

    .prose :global(a:hover) {
        color: var(--c-text);
    }

    .prose :global(ul),
    .prose :global(ol) {
        padding-left: 1.5em;
    }

    .prose :global(li) { margin: 0.35em 0; }
    .prose :global(li::marker) { color: var(--c-bracket); }

    .prose :global(blockquote) {
        padding: 0.25em 0 0.25em 1.25em;
        border-left: 2px solid var(--c-accent);
        color: var(--c-muted);
    }

    .prose :global(hr) {
        margin: 2.5em 0;
        border: 0;
        border-top: 1px solid var(--c-border);
    }

    .prose :global(code) {
        font-family: var(--font-mono);
        font-size: 0.85em;
    }

    .prose :global(:not(pre) > code) {
        padding: 0.1em 0.35em;
        border: 1px solid var(--c-border);
        border-radius: 4px;
    }

    /* Code blocks use Shiki's Everforest colors, light or dark with the site theme (the dark ones
       come as --shiki-dark variables); long lines scroll instead of wrapping. */
    .prose :global(pre) {
        border: 1px solid var(--c-border);
        padding: 1rem 1.25rem;
        border-radius: 8px;
        overflow-x: auto;
        font-size: 0.9375rem;
        line-height: 1.6;
    }

    :global(:root[data-theme='dark']) .prose :global(.astro-code),
    :global(:root[data-theme='dark']) .prose :global(.astro-code span) {
        color: var(--shiki-dark) !important;
        background-color: var(--shiki-dark-bg) !important;
    }

    /* Before the theme script runs (or without JavaScript), follow the system setting. */
    @media (prefers-color-scheme: dark) {
        :global(:root:not([data-theme])) .prose :global(.astro-code),
        :global(:root:not([data-theme])) .prose :global(.astro-code span) {
            color: var(--shiki-dark) !important;
            background-color: var(--shiki-dark-bg) !important;
        }
    }

    /* Wide tables scroll sideways on narrow screens instead of widening the page. */
    .prose :global(table) {
        display: block;
        overflow-x: auto;
        border-collapse: collapse;
        font-size: 0.9375rem;
        line-height: 1.5;
    }

    .prose :global(th),
    .prose :global(td) {
        padding: 0.5em 0.75em;
        border: 1px solid var(--c-border);
        text-align: left;
        vertical-align: top;
    }

    /* Folder names and identifiers in cells read better whole. */
    .prose :global(td code) {
        white-space: nowrap;
    }

    .prose :global(th) {
        font-weight: 600;
        background: var(--c-tint);
    }

    .prose :global(img) {
        max-width: 100%;
        height: auto;
        border-radius: 8px;
    }

    /* A numbered figure: the image framed like a printed page, a small caption under it. */
    .prose :global(figure) {
        margin: 0.5em 0 1.75em;
    }

    .prose :global(figure img) {
        display: block;
        width: 100%;
        border: 1px solid var(--c-border);
    }

    .prose :global(figcaption) {
        margin-top: 0.75em;
        font-family: var(--font-display);
        font-size: 0.9375rem;
        line-height: 1.5;
        color: var(--c-muted);
        text-align: center;
    }

    /* Older posts wrap an image and its caption in <div class="post-p-image">. */
    .prose :global(.post-p-image) {
        margin: 0 0 1.25em;
        text-align: center;
        font-size: 0.9375rem;
        color: var(--c-muted);
    }

    .prose :global(.post-p-image p) { margin: 0.5em 0 0; }

    /* ---- Paper: numbered sections ---- */
    .prose[data-variant='paper'] {
        counter-reset: section;
    }

    .prose[data-variant='paper'] :global(h2) {
        counter-increment: section;
        counter-reset: subsection;
    }

    .prose[data-variant='paper'] :global(h3) {
        counter-increment: subsection;
    }

    .prose[data-variant='paper'] :global(h2::before),
    .prose[data-variant='paper'] :global(h3::before) {
        margin-right: 0.5em;
        color: var(--c-accent);
        font-variant-numeric: tabular-nums;
    }

    .prose[data-variant='paper'] :global(h2::before) { content: counter(section) '.'; }
    .prose[data-variant='paper'] :global(h3::before) { content: counter(section) '.' counter(subsection); }

</style>
