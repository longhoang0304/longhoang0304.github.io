---
/**
 * One-line search input with an underline and a status at its end (e.g. "[3 matches]").
 * Carries the [data-search-input] / [data-search-status] hooks that lib/search.ts drives.
 */
interface Props {
    id: string;
    /** Accessible name; visually hidden. */
    label: string;
    placeholder?: string;
    /** Initial status text; the script keeps it up to date. */
    status?: string;
}

const { id, label, placeholder, status } = Astro.props;
---

<div class="field">
    <label for={id} class="visually-hidden">{label}</label>
    <input
            id={id}
            class="input"
            type="search"
            placeholder={placeholder}
            autocomplete="off"
            spellcheck="false"
            autofocus
            data-search-input
    />
    <span class="status" aria-live="polite" data-search-status>{status}</span>
</div>

<style>
    .field {
        display: flex;
        align-items: center;
        gap: 1.25rem;
        border-bottom: 1px solid var(--c-border);
        transition: border-color 0.2s ease;
    }

    .field:focus-within {
        border-color: var(--c-accent);
    }

    .input {
        flex: 1;
        min-width: 0;
        min-height: 44px;
        padding: 0.5rem 0;
        border: 0;
        outline: 0;
        background: transparent;
        color: var(--c-text);
        font-family: var(--font-display);
        font-size: 1.375rem;
        line-height: 1.35;
        caret-color: var(--c-accent);
    }

    .input::placeholder {
        color: var(--c-bracket);
    }

    /* Native clear button clashes with the look; Escape clears instead. */
    .input::-webkit-search-cancel-button {
        appearance: none;
    }

    .status {
        flex-shrink: 0;
        font-size: 0.875rem;
        color: var(--c-muted);
        font-variant-numeric: tabular-nums;
    }

    .visually-hidden {
        position: absolute;
        width: 1px;
        height: 1px;
        overflow: hidden;
        clip-path: inset(50%);
        white-space: nowrap;
    }

    @media (prefers-reduced-motion: reduce) {
        .field { transition: none; }
    }
</style>
