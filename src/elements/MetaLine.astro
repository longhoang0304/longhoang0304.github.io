---
/**
 * A line of bracketed details: [11 Oct 2026] - [Rant]. Dates (with a datetime) are re-formatted
 * for the visitor's locale by features/local-dates.ts.
 */
interface Props {
    items: { text: string; datetime?: string }[];
    /** Center the items, including any that wrap onto a second line. */
    centered?: boolean;
    /** Shown between the items: [11 Oct 2026] - [Research]. */
    separator?: string;
}

const { items, centered = false, separator } = Astro.props;
---

<p class="meta" data-centered={centered || undefined}>
    {items.map((m, i) => (
        <>
            {separator && i > 0 && <span class="separator" aria-hidden="true">{separator}</span>}
            {m.datetime ? <span>[<time datetime={m.datetime} data-local-date>{m.text}</time>]</span> : <span>[{m.text}]</span>}
        </>
    ))}
</p>

<style>
    .meta {
        display: flex;
        flex-wrap: wrap;
        margin: 0;
        font-size: 0.875rem;
        color: var(--c-muted);
        font-variant-numeric: tabular-nums;
    }

    .separator {
        padding: 0 0.5em;
    }

    .meta[data-centered] {
        justify-content: center;
    }
</style>
