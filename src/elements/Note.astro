---
/** A bracketed label and a line of text, e.g. "[Soon] Nowhere yet…", in place of an empty list. */
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'p'> & {
    label: string;
};

const { label, ...attrs } = Astro.props;
---

<p {...attrs} class="note">
    <span class="label">[{label}]</span>
    <span><slot /></span>
</p>

<style>
    .note {
        display: flex;
        align-items: center;
        gap: 1.25rem;
        min-height: 44px;
        margin: 0;
        padding: 0.625rem 0;
        font-family: var(--font-display);
        font-size: 1.375rem;
        line-height: 1.35;
        color: var(--c-muted);
    }

    .note[hidden] {
        display: none;
    }

    .label {
        flex-shrink: 0;
        font-family: var(--font-mono);
        font-size: 0.875rem;
    }

    @media (max-width: 480px) {
        .note { flex-direction: column; align-items: flex-start; gap: 0.25rem; }
    }
</style>
