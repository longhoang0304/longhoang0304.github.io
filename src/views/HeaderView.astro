---
import CornerBar from '../components/CornerBar.astro';
import BracketLink from '../elements/BracketLink.astro';
import LocalClock from '../elements/LocalClock.astro';
import SearchButton from '../elements/SearchButton.astro';
import ThemeToggle from '../elements/ThemeToggle.astro';
import type { NavLink } from '../lib/types';

interface Props {
    location: string;
    timeZone: string;
    /** Shown once the visitor has scrolled past the landing (which has its own nav). */
    links: NavLink[];
    /** Show the nav from the start, for pages without a landing section. */
    alwaysShowNav?: boolean;
}

const { location, timeZone, links, alwaysShowNav = false } = Astro.props;
---

<CornerBar edge="top">
    <span>{location}</span>
    <nav aria-label="Site" class="nav" data-always={alwaysShowNav || undefined}>
        {links.map((link) => (
                <BracketLink href={link.href}>{link.label}</BracketLink>
        ))}
    </nav>
    <div class="right">
        <LocalClock timeZone={timeZone} />
        <SearchButton />
        <ThemeToggle />
    </div>
</CornerBar>

<style>
    .nav {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 0 1rem;
        transition: opacity 0.3s ease, visibility 0.3s ease;
    }

    /* Hidden on the landing (before JS runs, too), visible on every later section. */
    :global(:root:not([data-section])) .nav:not([data-always]),
    :global(:root[data-section='top']) .nav:not([data-always]) {
        opacity: 0;
        visibility: hidden;
    }

    .right {
        display: inline-flex;
        align-items: center;
        gap: 0.75rem;
    }

    /* Not enough room for one row: nav drops to its own line under the bar. */
    @media (max-width: 800px) {
        .nav {
            order: 3;
            width: 100%;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .nav { transition: none; }
    }
</style>
