---
import FixedBar from '../components/FixedBar.astro';
import SocialLinks from '../components/SocialLinks.astro';

interface Props {
    year: number;
    githubUrl: string;
    linkedinUrl: string;
    email: string;
}

const { year, githubUrl, linkedinUrl, email } = Astro.props;
---

<FixedBar edge="bottom">
    <span>© {year}</span>
    <SocialLinks githubUrl={githubUrl} linkedinUrl={linkedinUrl} email={email} />
</FixedBar>
