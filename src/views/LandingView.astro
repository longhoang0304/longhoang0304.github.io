---
import AccentWord from '../elements/AccentWord.astro';
import BracketLink from '../elements/BracketLink.astro';
import Caret from '../elements/Caret.astro';
import Heading from '../elements/Heading.astro';
import type { NavLink } from '../features/types';

interface Props {
    links: NavLink[];
}

const { links } = Astro.props;
---

<section id="top" class="landing" aria-label="Introduction" data-section>
    <div class="center">
        <Heading as="h1" size="hero">
            Driven by <AccentWord>curiosity</AccentWord><Caret />
        </Heading>

        <nav aria-label="Main" class="nav">
            {links.map((link) => (
                    <BracketLink href={link.href} size="body">{link.label}</BracketLink>
            ))}
        </nav>
    </div>
</section>

<style>
    .landing {
        min-height: 100vh;
        min-height: 100dvh;
        box-sizing: border-box;
        display: flex;
        flex-direction: column;
        padding: var(--bar-space) var(--edge-x);
    }

    .center {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 3rem;
        padding: 4rem 0;
        text-align: center;
    }

    .nav {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 0.5rem 1.5rem;
    }

    @media (max-width: 480px) {
        .center { gap: 2rem; }
    }
</style>
