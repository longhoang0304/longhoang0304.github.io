---
import Abstract from '../components/Abstract.astro';
import LinkList from '../components/LinkList.astro';
import Prose from '../components/Prose.astro';
import TableOfContents from '../components/TableOfContents.astro';
import BracketLink from '../elements/BracketLink.astro';
import Heading from '../elements/Heading.astro';
import MetaLine from '../elements/MetaLine.astro';
import Text from '../elements/Text.astro';
import { toPostHeader } from '../features/post-header';
import type { Neighbours } from '../features/post-neighbours';
import { toNeighbourItems } from '../features/neighbour-items';
import type { SitePost } from '../features/site-posts';

interface Props {
    post: SitePost;
    minutes: number;
    /** The post's main sections (its h2s), for the table of contents. */
    sections: { slug: string; text: string }[];
    neighbours: Neighbours;
}

/** The post's rendered Markdown goes in the default slot. */
const { post, minutes, sections, neighbours } = Astro.props;
// `type: paper` posts get the research-paper look (abstract, keywords, numbered sections).
const paper = post.type === 'paper';
const { meta, summary, section } = toPostHeader(post);
const nextReads = toNeighbourItems(neighbours);
// A contents list only helps once there's something to skip between.
const toc = sections.length >= 3 ? sections.map((s) => ({ href: `#${s.slug}`, text: s.text, appendix: s.slug.startsWith('appendix') })) : [];
---

<div class="layout">
    <article class="post" aria-labelledby="post-title">
        <header class="head">
            <BracketLink href={section.href}>← {section.name}</BracketLink>
            <div class="title" data-paper={paper || undefined}>
                <MetaLine items={[...meta, { text: `${minutes} min read` }]} centered={paper} />
                <Heading as="h1" id="post-title">{post.title}</Heading>
                {paper
                    ? (post.abstract ?? summary) && <Abstract keywords={post.tags.map((tag) => ({ label: tag, href: `/tag/${tag}` }))}>{post.abstract ?? summary}</Abstract>
                    : summary && <Text>{summary}</Text>}
            </div>
        </header>

        <Prose variant={post.type}><slot /></Prose>

        <footer class="foot">
            {/* A paper lists its tags as keywords up top instead. */}
            {!(paper && (post.abstract ?? summary)) && post.tags.length > 0 && (
                    <nav aria-label="Tags" class="tags">
                        {post.tags.map((tag) => <BracketLink href={`/tag/${tag}`}>#{tag}</BracketLink>)}
                    </nav>
            )}
            {nextReads.length > 0 && <LinkList items={nextReads} aria-label="More posts" />}
            <BracketLink href={section.href}>← All {section.name.toLowerCase()}</BracketLink>
        </footer>
    </article>

    {toc.length > 0 && (
            <aside class="aside">
                <TableOfContents items={toc} numbered={paper} />
            </aside>
    )}
</div>

<style>
    /* One 40rem text column, centered; wide screens add the contents in the right margin. */
    .layout {
        /* Room for tables and code to break out of the text column: up to 8rem a side, never
           into the page gutters (the 1.5rem spare also covers a scrollbar). */
        --breakout: max(0px, min(8rem, (100vw - 40rem) / 2 - var(--edge-x) - 1.5rem));
        display: grid;
        grid-template-columns: 1fr minmax(0, 40rem) 1fr;
        box-sizing: border-box;
        padding: calc(var(--header-space) + 2rem) var(--edge-x) calc(var(--bar-space) + 4rem);
    }

    .post {
        grid-column: 2;
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: 3rem;
    }

    .aside {
        display: none;
    }

    /* Only where the margin fits the contents beside the widest tables. */
    @media (min-width: 90rem) {
        .aside {
            display: block;
            grid-column: 3;
            max-width: 15rem;
            padding-left: calc(var(--breakout) + 2rem);
        }

        .aside > :global(*) {
            position: sticky;
            top: 2rem;
        }
    }

    .head {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 1.5rem;
    }

    .title {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    /* Paper: a centered title block, the abstract a little apart from it. */
    .title[data-paper] {
        align-self: stretch;
        align-items: center;
        gap: 1.25rem;
        text-align: center;
    }

    .title[data-paper] > :global(section) {
        align-self: stretch;
        margin-top: 1rem;
    }

    .foot {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 2rem;
        padding-top: 1rem;
    }

    .foot > :global(ul) {
        align-self: stretch;
    }

    .tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0 1rem;
    }
</style>
